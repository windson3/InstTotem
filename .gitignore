/logs/
/downloads/
/tmp/
/temp/
*.log
*.tmp
*.temp
*.bak
*.old
*.orig
*.zip
*.sha256

# Dependencias e ferramentas locais
/node_modules/
/package.json
/package-lock.json
/references/
/.agents/
/.qodo/
/.vscode/
/.idea/

# Backups e sobras locais
/startup-backup-*/
/C*Instscript*
/scripts/Teste*/
/scripts/* - Copia*/

