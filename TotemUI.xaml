<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MainWindow"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="1200" Height="760"
        Title="Totem v4.0"
        FontFamily="Segoe UI">

  <Window.Resources>
    <!-- Toggle Card Style -->
    <Style x:Key="CardToggle" TargetType="CheckBox">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid x:Name="Root" Width="42" Height="22" Cursor="Hand">
              <Border x:Name="Track" Width="42" Height="22"
                      CornerRadius="11" Background="#3A3A50"/>
              <Ellipse x:Name="Dot" Width="16" Height="16"
                       Fill="White" HorizontalAlignment="Left"
                       VerticalAlignment="Center" Margin="3,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#C8142E"/>
                <Setter TargetName="Dot" Property="Margin" Value="23,0,3,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sidebar Button Active Style -->
    <Style x:Key="SideBtnStyle" TargetType="Button">
      <Setter Property="Background" Value="#101016"/>
      <Setter Property="Foreground" Value="#8C8CA0"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="6,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#2D0A12"/>
                <Setter Property="Foreground" Value="#F03C50"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Action Button (Accent) -->
    <Style x:Key="AccentBtn" TargetType="Button">
      <Setter Property="Background" Value="#C8142E"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#E03050"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#8C0C1E"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Ghost Button -->
    <Style x:Key="GhostBtn" TargetType="Button">
      <Setter Property="Background" Value="#191A1B"/>
      <Setter Property="Foreground" Value="#8A8F98"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderBrush" Value="#34343A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#28282C"/>
                <Setter Property="Foreground" Value="#F7F8F8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- Main Chrome -->
  <Border Background="#010102" CornerRadius="8" BorderBrush="#23252A" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ===== TOP BAR ===== -->
      <Grid x:Name="TopBar" Grid.Row="0" Background="#0A0A0F">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Accent line -->
        <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1" Background="#C8142E" Opacity="0.6"/>

        <!-- Logo + Title -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0">
          <Image x:Name="TopLogo" Source="__LOGO__" Width="32" Height="32" Stretch="Uniform"/>
          <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
            <TextBlock Text="TOTEM" FontSize="15" FontWeight="Bold" Foreground="#F7F8F8"/>
            <TextBlock Text="Automacao Gtech Arcade" FontSize="9" Foreground="#62666D"/>
          </StackPanel>
        </StackPanel>

        <!-- Status badges -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
          <Border Background="#27A644" CornerRadius="3" Padding="6,2" Margin="0,0,4,0">
            <TextBlock Text="ADMIN" FontSize="8" FontWeight="Bold" Foreground="White"/>
          </Border>
          <Border Background="#C8142E" CornerRadius="3" Padding="6,2" Margin="0,0,4,0">
            <TextBlock Text="v4.0" FontSize="8" FontWeight="Bold" Foreground="White"/>
          </Border>
        </StackPanel>

        <!-- Window controls -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,6,0">
          <Button x:Name="btnMinimize" Content="-" Width="30" Height="30"
                  Background="Transparent" Foreground="#62666D"
                  FontSize="14" Cursor="Hand" BorderThickness="0"/>
          <Button x:Name="btnClose" Content="x" Width="30" Height="30"
                  Background="Transparent" Foreground="#DC283C"
                  FontSize="14" Cursor="Hand" BorderThickness="0" FontWeight="Bold"/>
        </StackPanel>
      </Grid>

      <!-- ===== BODY ===== -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#0F1011" Padding="6,10">
          <StackPanel>
            <TextBlock Text="NAVEGACAO" FontSize="8" FontWeight="Bold" Foreground="#62666D" Margin="8,0,0,6"/>

            <Button x:Name="side_dashboard" Content="  Dashboard" Style="{StaticResource SideBtnStyle}"/>
            <Button x:Name="side_install" Content="  Instalar" Style="{StaticResource SideBtnStyle}"/>
            <Button x:Name="side_tweaks" Content="  Tweaks" Style="{StaticResource SideBtnStyle}"/>
            <Button x:Name="side_services" Content="  Servicos" Style="{StaticResource SideBtnStyle}"/>
            <Button x:Name="side_registry" Content="  Registro" Style="{StaticResource SideBtnStyle}"/>
            <Button x:Name="side_presets" Content="  Presets" Style="{StaticResource SideBtnStyle}"/>

            <Border Height="1" Background="#23252A" Margin="6,12"/>

            <Button x:Name="side_backup" Content="  Backup" Style="{StaticResource SideBtnStyle}"/>
            <Button x:Name="side_restore" Content="  Restaurar" Style="{StaticResource SideBtnStyle}"/>
            <Button x:Name="side_repair" Content="  Reparar SO" Style="{StaticResource SideBtnStyle}"/>
            <Button x:Name="side_settings" Content="  Configuracoes" Style="{StaticResource SideBtnStyle}"/>

            <Border Height="1" Background="#23252A" Margin="6,12"/>

            <Button x:Name="btnRunAll" Content="EXECUTAR TUDO" Style="{StaticResource AccentBtn}" Height="38" Margin="6,8"/>
          </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Background="#010102">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- View title -->
          <Border Grid.Row="0" Background="#0A0A0F" Padding="18,10" BorderBrush="#23252A" BorderThickness="0,0,0,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="ViewTitle" Text="Dashboard" FontSize="16" FontWeight="SemiBold" Foreground="#F7F8F8" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnSelectAll" Content="Selecionar Tudo" Style="{StaticResource GhostBtn}" Margin="0,0,4,0"/>
                <Button x:Name="btnDeselectAll" Content="Limpar" Style="{StaticResource GhostBtn}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- View content -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,12">
            <StackPanel x:Name="ViewPanel"/>
          </ScrollViewer>

          <!-- Bottom bar -->
          <Border Grid.Row="2" Background="#0A0A0F" Padding="18,8" BorderBrush="#23252A" BorderThickness="0,1,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <ProgressBar x:Name="ProgressBar" Height="3" Minimum="0" Maximum="100" Value="0"
                             Background="#191A1B" Foreground="#C8142E" BorderThickness="0"/>
                <TextBlock x:Name="ProgressText" Text="Pronto." FontSize="10" Foreground="#62666D" Margin="0,3,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnApplyView" Content="Aplicar" Style="{StaticResource AccentBtn}" Height="32" Margin="0,0,6,0"/>
                <Button x:Name="btnUndoView" Content="Reverter" Style="{StaticResource GhostBtn}" Height="32"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <!-- LOG PANEL -->
        <Border Grid.Column="2" Background="#0A0A0F" BorderBrush="#23252A" BorderThickness="1,0,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0F1011" Padding="10,8" BorderBrush="#23252A" BorderThickness="0,0,0,1">
              <Grid>
                <TextBlock Text="LOG" FontSize="8" FontWeight="Bold" Foreground="#62666D" VerticalAlignment="Center"/>
                <Button x:Name="btnClearLog" Content="Limpar" HorizontalAlignment="Right" Style="{StaticResource GhostBtn}" FontSize="9" Padding="6,2"/>
              </Grid>
            </Border>

            <ListBox x:Name="LogList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     FontFamily="Consolas" FontSize="10" Foreground="#8A8F98" Padding="6,2"/>

            <Border Grid.Row="2" Background="#0F1011" Padding="6,4" BorderBrush="#23252A" BorderThickness="0,1,0,0">
              <TextBlock Text="Totem v4.0 - Gtech" FontSize="8" Foreground="#34343A"/>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
